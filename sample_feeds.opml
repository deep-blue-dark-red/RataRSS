<?xml version="1.0" encoding="UTF-8"?>
<opml version="2.0">
  <head>
    <title>NetNewsWire Curated Subscriptions</title>
  </head>
  <body>
    <outline text="Fin Econ" title="Fin Econ">
      <outline type="rss" text="Bloomberg Markets" title="Bloomberg Markets" xmlUrl="https://feeds.bloomberg.com/markets/news.rss" htmlUrl="https://www.bloomberg.com/markets" />
      <outline type="rss" text="FT Alphaville" title="FT Alphaville" xmlUrl="https://www.ft.com/alphaville?format=rss" htmlUrl="https://www.ft.com/alphaville" />
      <outline type="rss" text="Marginal Revolution" title="Marginal Revolution" xmlUrl="https://marginalrevolution.com/feed" htmlUrl="https://marginalrevolution.com" />
      <outline type="rss" text="Econlib" title="Econlib" xmlUrl="https://www.econlib.org/feed/" htmlUrl="https://www.econlib.org" />
      <outline type="rss" text="Calculated Risk" title="Calculated Risk" xmlUrl="https://calculatedrisk.substack.com/feed" htmlUrl="https://calculatedrisk.substack.com" />
    </outline>
    <outline text="2020s" title="2020s">
      <outline type="rss" text="Ars Technica" title="Ars Technica" xmlUrl="https://feeds.arstechnica.com/arstechnica/index" htmlUrl="https://arstechnica.com" />
      <outline type="rss" text="xkcd.com" title="xkcd.com" xmlUrl="https://xkcd.com/rss.xml" htmlUrl="https://xkcd.com" />
      <outline type="rss" text="Data Colada" title="Data Colada" xmlUrl="https://datacolada.org/feed" htmlUrl="https://datacolada.org" />
    </outline>
    <outline type="rss" text="Hacker News" title="Hacker News" xmlUrl="https://news.ycombinator.com/rss" htmlUrl="https://news.ycombinator.com" />
    <outline type="rss" text="Rust Blog" title="Rust Blog" xmlUrl="https://blog.rust-lang.org/feed.xml" htmlUrl="https://blog.rust-lang.org" />
  </body>
</opml>
